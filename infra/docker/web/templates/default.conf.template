# nginx 공식 이미지의 템플릿 기능이 기동 때 /etc/nginx/conf.d/default.conf 로 렌더링한다(정의된 환경변수만 치환하므로
# $uri·$host 같은 nginx 변수는 그대로 남는다). 치환 변수: SERVER_NAME, APP_PROFILE (compose 의 web 서비스 environment).
# 인증서는 호스트의 CERT_DIR 를 /etc/nginx/certs 로 읽기 전용 mount 한다.
server {
    listen 80;
    server_name ${SERVER_NAME};

    # web 컨테이너 헬스체크용(리다이렉트하지 않는다)
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${SERVER_NAME};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # 프런트엔드 정적 파일(이미지에 들어 있는 Verify 단계의 frontend/dist)
    root /usr/share/nginx/html;

    location / {                         # SPA 라우팅
        try_files $uri /index.html;
    }
    location /assets/ {                  # 해시 파일명: 장기 캐시
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
    }
    location = /config.json {            # 프로파일별 런타임 설정(이미지에 포함)
        alias /usr/share/nginx/config/config.${APP_PROFILE}.json;
        add_header Cache-Control "no-cache";
    }

    # 첨부 업로드만 본문 한도를 올린다(앱 한도 100MB + multipart 여유). 다른 /api/ 요청은 기본 1MB 유지
    location ~ ^/api/v1/deals/[^/]+/attachments$ {
        client_max_body_size 101m;
        client_body_timeout 300s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 백엔드 API와 상태 확인(로드밸런서·가동 감시용)
    location /api/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /healthz { proxy_pass http://api:8000; proxy_set_header X-Forwarded-For $remote_addr; }
    location = /readyz  { proxy_pass http://api:8000; proxy_set_header X-Forwarded-For $remote_addr; }
}
