# compose 변수 예시(비밀 없음). 서버에서는 /opt/neoine-sales/deploy.env 로 두고 scripts/setup.sh 의 서버 준비 모드가 만든다.
APP_HOME=/opt/neoine-sales
APP_PROFILE=product
APP_UID=1001
APP_GID=1001
API_WORKERS=4
SERVER_NAME=sales.internal.example.com
CERT_DIR=/opt/neoine-sales/certs
REGISTRY=registry.internal.example.com
DB_DATA_DIR=/var/lib/neoine-sales-postgres
