# Python / uv
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
# Env / secrets
.env
.env.*
!.env.example
# Node
node_modules/
dist/
# OS
.DS_Store
.import_linter_cache/

# IDE (JetBrains): 개인 설정은 제외하고, 팀 공유용 코드 스타일/인스펙션 프로필만 추적
.idea/*
!.idea/codeStyles/
!.idea/inspectionProfiles/
*.iml

# 하네스: 실행 산출물(로컬 작업 기록)과 개인 설정은 추적하지 않음
artifacts/
.claude/settings.local.json
build/
reports/
# Reports 기능 소스·테스트 폴더는 추적한다(위 reports/ 규칙의 예외)
!backend/tests/functional/reports/
!frontend/src/**/reports/

# 로컬 실행 로그(scripts/start-*.sh)
logs/
