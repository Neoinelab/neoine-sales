# backend/.env.example  ->  로컬에서는 backend/.env 로 복사해 사용한다 (.env·.env.*는 git 제외)
# 로컬에서 dev DB로 띄우려면 backend/.env.dev 로 복사해 APP_PROFILE=dev와 dev 접속 정보를 넣고
# ./scripts/start-backend.sh --profile dev 로 실행한다(APP_ENV_FILE=.env.dev로 그 파일만 읽음).
# product 값은 서버의 /opt/neoine-sales/.env 에서 관리한다 (compose가 컨테이너의 /app/.env로 읽기 전용 mount) (docs/dev-guide.html 3.5절)
APP_PROFILE=local

# 데이터 저장소 (로컬에 설치한 PostgreSQL 기준, docs/dev-guide.html 3.4절)
# CHANGE_ME를 로컬 DB 비밀번호로 바꾼다. 특수문자는 URL 인코딩한다(예: ! -> %21, @ -> %40).
APP_DATABASE_URL=postgresql+asyncpg://neoine:CHANGE_ME@localhost:5432/neoinesales

# 보안 (로컬 전용 값. dev/product에서는 절대 재사용 금지)
APP_JWT_SECRET=local-only-secret-change-me-0123456789abcdef
APP_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
# AD 바인드 비밀번호 암호화 키(필수, Fernet 키). 아래는 예시이며 product는 이 값을 거부한다.
# 새 키: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SETTINGS_ENCRYPTION_KEY=ZXhhbXBsZS1rZXktbm90LWZvci1wcm9kdWN0aW9uISE=

# 로그인: AD(LDAP) 서버 접속 정보는 최초 설정 화면에서 등록하므로 환경변수가 없다.
# AD 사용자 비밀번호 바인드를 <아이디>@<도메인> 형식으로 하려면 도메인을 넣는다(앞에 @ 없이).
# 없거나 비우면 서비스 계정으로 검색한 항목의 DN으로 바인드한다. 바꾸면 재시작해야 적용된다.
# APP_AD_LOGIN_DOMAIN=neoine.co.kr

# 앱 내 스케줄러(Forecast 월말 스냅숏 확인). local은 기본 꺼짐, dev·product는 기본 켜짐
# APP_SCHEDULER_ENABLED=false
# APP_FORECAST_SNAPSHOT_CHECK_INTERVAL_SECONDS=600   (30~3600)

# docker compose(product)의 db 컨테이너가 읽는 이름. 서버 .env에서 scripts/setup.sh가 생성한다(비밀번호는 생성값).
# POSTGRES_USER=neoine
# POSTGRES_DB=neoinesales
# POSTGRES_PASSWORD=

# 선택
# APP_REDIS_URL=redis://localhost:6379/0   (현재 미사용: 큐·캐시를 도입할 때 사용)
# APP_SENTRY_DSN=
# APP_SMTP_HOST=localhost
# APP_SMTP_PORT=1025
