# backend/.env.example  ->  로컬에서는 backend/.env 로 복사해 사용한다 (.env는 git 제외)
# dev/product 값은 서버의 /opt/neoine-sales/.env 에서 관리한다 (systemd WorkingDirectory의 .env를 읽음) (docs/dev-guide.html 3.5절)
APP_PROFILE=local

# 데이터 저장소 (로컬에 설치한 PostgreSQL 기준, docs/dev-guide.html 3.4절)
# CHANGE_ME를 로컬 DB 비밀번호로 바꾼다. 특수문자는 URL 인코딩한다(예: ! -> %21, @ -> %40).
APP_DATABASE_URL=postgresql+asyncpg://neoine:CHANGE_ME@localhost:5432/neoinesales

# 보안 (로컬 전용 값. dev/product에서는 절대 재사용 금지)
APP_JWT_SECRET=local-only-secret-change-me-0123456789abcdef
APP_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# 로그인: AD(LDAP) 서버는 최초 설정 화면에서 등록하므로 환경변수가 없다.
# 로컬은 개발용 로그인(APP_DEV_LOGIN_ENABLED, local 기본 true)을 쓸 수 있다(dev/product에서는 켤 수 없다).

# 선택
# APP_REDIS_URL=redis://localhost:6379/0   (현재 미사용: 큐·캐시를 도입할 때 사용)
# APP_SENTRY_DSN=
# APP_SMTP_HOST=localhost
# APP_SMTP_PORT=1025
